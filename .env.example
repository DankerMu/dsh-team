# Copy to .env for local runs. Variable names only; never commit real values.
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8080
PLATFORM_LOG_LEVEL=info
PLATFORM_DATA_DIR=./data
# Unset defaults to <PLATFORM_DATA_DIR>/managed-config. Relative and absolute values resolve to absolute paths. Blank, whitespace-only, or NUL values are rejected.
PLATFORM_MANAGED_CONFIG_DIR=./data/managed-config
# Required absolute HTTP(S) origin: hostname or IP, optional port, optional trailing /.
PLATFORM_PUBLIC_URL=http://127.0.0.1:8080
# Exact true or false; default false. Independent of PLATFORM_PUBLIC_URL scheme (TLS is external).
PLATFORM_COOKIE_SECURE=false
# Comma-separated bare IPv4/IPv6 literals, members trimmed. Empty means none. No hostname, CIDR, or wildcard.
PLATFORM_TRUSTED_PROXIES=
