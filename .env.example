# Copy to .env for local runs. Variable names only; never commit real values.
# For Compose, set PLATFORM_HOST to 0.0.0.0 and both directory values to absolute host paths
# pre-created writable by uid 1000. Compose mounts each directory at the identical path.
# From repository root: docker compose --project-directory . --env-file .env -f deploy/compose.yml up -d
# Local runs without compose (pnpm dev, pnpm dev:bg, pnpm start): a verbatim copy stops before
# listening at the empty DOCUMENT_SERVER_JWT_SECRET. Either delete both Document Server lines
# (Office unavailable) or fill both with nonempty values.
# Bare IPv4/IPv6 or ASCII DNS hostname; no URL, port, whitespace or blank value.
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8080
PLATFORM_LOG_LEVEL=info
PLATFORM_DATA_DIR=./data
# Unset defaults to <PLATFORM_DATA_DIR>/managed-config. Relative and absolute values resolve to absolute paths. Blank, whitespace-only, or NUL values are rejected.
PLATFORM_MANAGED_CONFIG_DIR=./data/managed-config
# Absolute, nonempty, NUL-free Unix socket. Connected only when a Docker operation is requested.
PLATFORM_DOCKER_SOCKET=/var/run/docker.sock
# Local image tag; resolved to one immutable image ID for composition and DSH startup.
PLATFORM_USER_IMAGE=dsh-team-user:local
# Resolved absolute; loaded and validated only on instance startup, not health startup.
PLATFORM_SECCOMP_PROFILE=images/seccomp/dsh-user.json
# Canonical IPv4 network /0 through /28, no host bits. Unset defaults to 172.30.0.0/16.
# Choose a pool that does not conflict with host/LAN/Docker ranges. Its /28 count must
# cover persisted maxRunningInstances (default 60); invalid or insufficient pools stop startup.
PLATFORM_SUBNET_POOL=172.30.0.0/16
# Deployment default: platform container joins each owned bridge; instances publish no host ports.
# Select published-loopback ONLY for a platform process running directly on the Docker host.
PLATFORM_UPSTREAM_MODE=network
# Exact Docker container name (not a URL, path or ID shorthand). Resolved only during lifecycle work.
PLATFORM_CONTAINER_NAME=dsh-team-platform
# Managed overlays must have the same absolute path here and on the Docker host.
# Required absolute HTTP(S) origin: hostname or IP, optional port, optional trailing /.
PLATFORM_PUBLIC_URL=http://127.0.0.1:8080
# Exact true or false; default false. Independent of PLATFORM_PUBLIC_URL scheme (TLS is external).
PLATFORM_COOKIE_SECURE=false
# Comma-separated bare IPv4/IPv6 literals, members trimmed. Empty means none. No hostname, CIDR, or wildcard.
PLATFORM_TRUSTED_PROXIES=
# Optional absolute host directory of licensed fonts, bound read-only into every employee instance
# at /usr/share/fonts/truetype/custom. Compose mounts it at the identical path in the platform
# container; it must be a readable directory there. Empty or unset means no fonts bind.
PLATFORM_INSTANCE_FONTS_DIR=
# Trusted giap-vps verification only; never needed by ordinary platform startup.
# Supply privately to pnpm test:model through the approved environment loader.
# DMXAPI_KEY=
# CHROME_BIN=<complete pinned CfT156.0.8078.80 chrome-headless-shell executable>
# CI-only, supplied by trusted invocation provisioning; do not set in platform deployment.
# DSH_TEAM_CI_RESOURCE_JOURNAL=<private invocation resource journal>
# DSH_TEAM_VPS_CHANNEL=<temporary restricted SSH capability; never the model key>
# Compose-only supplementary group. Fill with: stat -c %g /var/run/docker.sock
# Keep the non-root image user; never make the socket world-writable.
DEPLOY_DOCKER_GID=
# Bundled Document Server container name, read by the platform. Same value as the delivered
# compose literal: compose fixes it and does not read this line. No platform default; set both
# Document Server values or neither (an empty value is rejected, never treated as unset).
DOCUMENT_SERVER_CONTAINER_NAME=dsh-team-documentserver
# Read by both the platform and compose: the delivered compose passes this one value to the
# bundled Document Server and the platform. Compose deployments must fill it with a long random
# value; empty or unset stops compose before any container is created. Compose also needs the
# operator font directory assets/fonts/ under the repository root (Document Server creation
# fails without it).
DOCUMENT_SERVER_JWT_SECRET=
