{
  "name": "dsh-team",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "pnpm build:web && bash scripts/dev-watch.sh",
    "dev:web": "pnpm --filter @dsh-team/web dev",
    "dev:bg": "bash scripts/dev-server.sh start",
    "dev:stop": "bash scripts/dev-server.sh stop",
    "dev:status": "bash scripts/dev-server.sh status",
    "logs": "bash scripts/dev-server.sh logs",
    "start": "node --env-file-if-exists=.env platform/dist/main.js",
    "cli": "node platform/src/cli.ts",
    "check": "pnpm fmt:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:integration && pnpm build && pnpm contract:check && pnpm anti-drift",
    "check:fast": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0 && pnpm lint:deps && pnpm lint:tests && pnpm lint:shell && pnpm lint:agents && pnpm lint:config && pnpm lint:ci",
    "lint:deps": "depcruise platform $([ -d plugins ] && echo plugins) --config .dependency-cruiser.cjs",
    "lint:tests": "bash scripts/check-test-pairing.sh",
    "lint:shell": "shellcheck scripts/*.sh .git-hooks/*.sh .husky/pre-commit .husky/commit-msg",
    "lint:agents": "bash scripts/check-agents-commands.sh",
    "lint:config": "node scripts/check-config.mjs",
    "lint:ci": "node scripts/check-ci-concurrency.mjs",
    "typecheck": "tsc --noEmit && pnpm --filter @dsh-team/web typecheck && tsc -p plugins/zh-locale/tsconfig.json && tsc -p plugins/permission-tiers/tsconfig.json && tsc -p plugins/office-agents/tsconfig.json && tsc -p plugins/platform-nav/tsconfig.json",
    "test": "vitest run --project unit --coverage",
    "test:integration": "pnpm build:web && vitest run --project integration",
    "test:ui": "pnpm build:web && playwright test",
    "test:ui:install": "playwright install --with-deps chromium",
    "test:cli": "vitest run --project integration platform/test/cli.integration.test.ts",
    "test:docker": "node scripts/verify-browser-runtime.mjs docker",
    "verify:docker": "node scripts/trusted-docker-run.mjs",
    "test:deploy": "vitest run --project docker platform/test/deployment.docker.test.ts",
    "test:stack": "node scripts/test-stack.mjs",
    "test:model": "node scripts/verify-browser-runtime.mjs model",
    "ci:model:invoke": "node scripts/ci-vps-invoke.mjs",
    "ci:model": "node scripts/ci-vps-run.mjs",
    "verify:docker-evidence": "node platform/test/verify-docker-evidence.ts",
    "build": "pnpm build:web && tsc -p platform/tsconfig.build.json && rm -rf platform/dist/db/migrations && cp -R platform/src/db/migrations platform/dist/db/migrations",
    "build:web": "pnpm --filter @dsh-team/web build",
    "contract:write": "node platform/scripts/openapi.ts --write",
    "contract:check": "node platform/scripts/openapi.ts --check",
    "duplicate-code": "jscpd platform --config jscpd.json --threshold \"$(node scripts/constraints.mjs anti_drift duplicate_code_threshold_percent)\"",
    "dead-code": "knip",
    "anti-drift": "pnpm duplicate-code && pnpm dead-code",
    "smoke": "hurl --test --variable base_url=\"http://127.0.0.1:${PLATFORM_PORT:-8080}\" smoke/*.hurl",
    "e2e": "bash scripts/e2e.sh",
    "test:guardrails": "bash scripts/test-guardrails.sh",
    "change-scope": "bash scripts/change-scope.sh",
    "probe:sandbox": "bash scripts/probe-sandbox.sh",
    "probe:dsh-api": "node scripts/verify-browser-runtime.mjs dsh-api",
    "probe:first-run": "node scripts/verify-browser-runtime.mjs first-run"
  },
  "lint-staged": {
    "*.{ts,tsx,mjs,cjs}": [
      "eslint --max-warnings 0 --no-warn-ignored",
      "prettier --write --ignore-unknown"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint/compat": "2.1.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.2",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.13.0",
    "husky": "9.1.7",
    "jscpd": "5.4.2",
    "jsdom": "26.1.0",
    "knip": "6.42.0",
    "lint-staged": "17.5.1",
    "prettier": "3.9.10",
    "react": "18.3.1",
    "react-test-renderer": "18.3.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.2",
    "yaml": "2.9.1"
  }
}
