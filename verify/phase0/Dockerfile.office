# DSH user image with pnpm and the approved Office plugins preinstalled into the profile.
FROM dsh-poc:0.2.0-rc.2
USER root
RUN npm install -g pnpm@11.7.0 && apt-get update && apt-get install -y --no-install-recommends python3-pip && pip3 install --break-system-packages python-docx openpyxl && rm -rf /var/lib/apt/lists/*
USER dsh
RUN cd /tmp && (dsh --profile web --help >/dev/null 2>&1 || true) && dsh plugin --profile web add dsh-better-sidebar dsh-sidebar-onlyoffice
WORKDIR /data/work
