{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.mjs",
        "plugins/office-agents/index.js",
        "plugins/office-agents/docx-construction.js",
        "plugins/office-agents/*.test.js",
        "plugins/permission-tiers/index.js",
        "plugins/permission-tiers/*.test.js"
      ],
      "project": [
        "*.{ts,mjs,cjs}",
        "scripts/*.mjs",
        "plugins/office-agents/*.js",
        "plugins/office-agents/*.d.ts",
        "plugins/permission-tiers/*.js",
        "plugins/permission-tiers/*.d.ts"
      ]
    },
    "platform": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts", "test/ci-vps-worker.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts"]
    },
    "platform/web": {
      "entry": ["index.html", "src/**/*.test.{ts,tsx}"],
      "project": ["src/**/*.{ts,tsx}", "test/**/*.{ts,tsx}"]
    }
  },
  "ignoreDependencies": [
    "@deepseek-ai/dsh-agent-preset-registry",
    "@deepseek-ai/dsh-llm",
    "@deepseek-ai/dsh-session-checkpoint-policy"
  ],
  "ignoreBinaries": ["hurl", "shellcheck", "systemd-run", "flock", "busctl"]
}
